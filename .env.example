# Example only. These are synthetic local-development settings, not credentials.
# Export variables explicitly; the app never auto-loads a .env file.
TRADING_EXECUTION_MODE=paper
TRADING_DATABASE_URL=postgresql+psycopg://paper@postgres:5432/paper
TRADING_VALKEY_URL=redis://valkey:6379/0
TRADING_INITIAL_CASH=100000
TRADING_MAX_CAPITAL_PER_TRADE=10000
TRADING_MAX_PORTFOLIO_EXPOSURE=50000
TRADING_MAX_OPEN_POSITIONS=5
TRADING_MAX_DAILY_LOSS=5000
TRADING_ALLOWED_SYMBOLS=["DEMO"]
TRADING_ALLOWED_INSTRUMENT_TYPES=["equity"]
TRADING_QUOTE_MAX_AGE_SECONDS=30
TRADING_MANDATORY_STOP_LOSS=true
TRADING_MARKET_OPEN=09:15:00
TRADING_MARKET_CLOSE=15:30:00
# Populate from an official calendar before any realistic simulation.
TRADING_HOLIDAYS=[]
